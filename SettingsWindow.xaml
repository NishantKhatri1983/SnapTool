<Window x:Class="SnapTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnapTool"
        Title="SnapTool Settings" Width="680" Height="760" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="#FFF5F5F5" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF202020"/>
            <Setter Property="Margin" Value="2,20,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FF303030"/>
            <Setter Property="Margin" Value="0,6,14,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#FF777777"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FFECECEC" BorderBrush="#FFD8D8D8" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AdvancedButton" Content="Edit settings.json…" ToolTip="Palette, tool shortcuts and per-tool styles live in the JSON file"/>
                    <Button x:Name="ResetButton" Content="Reset to defaults" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Content="Save" IsDefault="True" MinWidth="90"/>
                    <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,0,22,22">

                <!-- Hotkeys -->
                <TextBlock Style="{StaticResource Section}" Text="Hotkeys"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Capture"/>
                        <StackPanel Grid.Column="1" Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <local:HotkeyBox x:Name="CaptureKey"/>
                                <Button x:Name="CaptureClear" Content="Clear" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="CaptureStatus" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Scrolling capture"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <local:HotkeyBox x:Name="ScrollKey"/>
                                <Button x:Name="ScrollClear" Content="Clear" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="ScrollStatus" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Click a box and press the keys you want, e.g. Ctrl+Shift+S, Win+Shift+X, F8 or PrintScreen. Backspace clears it. Your hotkeys are paused while this window is open."/>
                            <TextBlock x:Name="PrintScreenHint" Style="{StaticResource Hint}" Visibility="Collapsed" Foreground="#FFB25E00">
                                Print Screen: also turn off Windows' "Use the Print screen key to open screen capture", and quit any other screenshot tool using it or change its key.
                                <Hyperlink x:Name="KeyboardSettingsLink">Open Windows keyboard settings</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- After capture -->
                <TextBlock Style="{StaticResource Section}" Text="After a capture"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="CopyBox" Content="Copy the image to the clipboard"/>
                        <CheckBox x:Name="AutoSaveBox" Content="Save it automatically to the save folder"/>
                        <CheckBox x:Name="OpenEditorBox" Content="Open it in the editor"/>
                        <CheckBox x:Name="NotifyBox" Content="Show a notification (click it to open the editor)"/>
                    </StackPanel>
                </Border>

                <!-- Saving -->
                <TextBlock Style="{StaticResource Section}" Text="Saving"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Save folder"/>
                        <DockPanel Grid.Column="1" Margin="0,4">
                            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0"/>
                            <TextBox x:Name="FolderBox" Padding="6,4" VerticalContentAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="File name" VerticalAlignment="Top" Margin="0,10,14,6"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                            <TextBox x:Name="TemplateBox" Padding="6,4"/>
                            <TextBlock x:Name="TemplatePreview" Style="{StaticResource Hint}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{}{yyyy-MM-dd} {HH-mm-ss} etc. insert the date and time, {n:000} a running number."/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Format"/>
                        <ComboBox x:Name="FormatBox" Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <ComboBoxItem Content="PNG (sharp, best for screenshots)" Tag="png"/>
                            <ComboBoxItem Content="JPG (smaller files)" Tag="jpg"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="JPG quality"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Slider x:Name="QualitySlider" Minimum="40" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QualityValue" VerticalAlignment="Center" Margin="10,0,0,0" Width="40"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Editor -->
                <TextBlock Style="{StaticResource Section}" Text="Editor"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <TextBlock Style="{StaticResource Label}" Text="Start with tool" Width="156"/>
                            <ComboBox x:Name="DefaultToolBox"/>
                        </StackPanel>
                        <CheckBox x:Name="OverwriteBox" Content="Save (Ctrl+S) overwrites the capture file  (off: saves name_edited.png next to it)"/>
                        <CheckBox x:Name="ConfirmBox" Content="Ask to save unsaved markup when closing or switching images"/>
                        <CheckBox x:Name="RememberBox" Content="Remember the last color, width and style of each tool"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="RecentBox" Content="Show the recent captures timeline, with up to"/>
                            <ComboBox x:Name="RecentCountBox" MinWidth="70" Margin="8,0,6,0"/>
                            <TextBlock Text="images" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Editor changes apply to editor windows opened after saving."/>
                    </StackPanel>
                </Border>

                <!-- Capture overlay -->
                <TextBlock Style="{StaticResource Section}" Text="Capture screen"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="MagnifierBox" Content="Show the magnifier with pixel position and color"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource Label}" Text="Dim the screen" Width="156"/>
                            <Slider x:Name="DimSlider" Minimum="0" Maximum="80" Width="220" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DimValue" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource Label}" Text="Selection color" Width="156"/>
                            <Button x:Name="AccentButton" Width="44" Height="24" Padding="0" ToolTip="Pick a color">
                                <Border x:Name="AccentSwatch" Width="34" Height="16" CornerRadius="3"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Scrolling -->
                <TextBlock Style="{StaticResource Section}" Text="Scrolling capture"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <TextBlock Style="{StaticResource Label}" Text="How it scrolls" Width="156"/>
                            <ComboBox x:Name="ScrollModeBox">
                                <ComboBoxItem Content="Manual – I scroll, Enter / End finishes" Tag="Manual"/>
                                <ComboBoxItem Content="Automatic – SnapTool scrolls the window" Tag="Auto"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Manual: after choosing the area, scroll with the wheel, the scrollbar or the keyboard – up or down – and press Enter or End when you've captured enough. Esc cancels."/>
                        <CheckBox x:Name="ScrollTopBox" Content="Scroll to the top before capturing (automatic mode)"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource Label}" Text="Stop at a height of" Width="156"/>
                            <ComboBox x:Name="MaxHeightBox"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource Label}" Text="Wait after each scroll (auto)" Width="156"/>
                            <Slider x:Name="SettleSlider" Minimum="60" Maximum="1000" Width="220" IsSnapToTickEnabled="True" TickFrequency="20" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettleValue" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Increase the wait if pages load slowly and the stitched image has gaps or repeats."/>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Style="{StaticResource Section}" Text="General"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="StartupBox" Content="Start SnapTool when I sign in to Windows"/>
                        <TextBlock x:Name="SettingsPath" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
